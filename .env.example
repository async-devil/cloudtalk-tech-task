# Copy this file to .env — NEVER commit .env (it is gitignored).
# .env is loaded only in `test` mode; comments must be on their OWN line
# (the config parser treats `#` as whole-line comments — an inline `# note`
# after a value becomes part of the value).
#
# Generated from the composed config slice schemas — do not hand-edit; edit the owning slice's
# `.describe()` annotations instead.

# --- boot ---------------------------------------------------------------
# Required: test | staging | production. No default — boot refuses without it (ADR-0005).
# `test` uses stubs + lenient config (local dev / CI); staging & production are real + fail-closed.
APP_MODE=

# --- api --------------------------------------------------------------------
# API listen port.
# PORT=3000
# API bind address.
# HOST=0.0.0.0
# Per-IP ceiling for /api/auth/* requests. Dev-mode loosening is higher limits, never a disabled limiter (100x the fail-closed default in the test tier).
# RATE_LIMIT_AUTH_PER_MINUTE=1000
# Per-IP ceiling for a POST with no resolved session.
# RATE_LIMIT_UNAUTHENTICATED_POST_PER_MINUTE=3000
# Per-IP ceiling for a GET with no resolved session (ADR-0019) — every anonymous catalogue/product/review-list read.
# RATE_LIMIT_ANONYMOUS_READ_PER_MINUTE=12000
# Per-user ceiling for reviews.submit/reviews.update with a resolved session (ADR-0019), keyed by the internal user id rather than client IP.
# RATE_LIMIT_REVIEW_SUBMISSION_PER_MINUTE=1000
# Per-recipient-address magic-link send ceiling — bounds one IP directing unlimited magic-link emails at a single victim address. Enforced inside packages/auth's send hook (the address only exists there), via a limiter this app constructs and injects through AuthDependencies.
# RATE_LIMIT_MAGIC_LINK_PER_ADDRESS_PER_HOUR=500
# When true, client IP is read from X-Forwarded-For's first hop. Default false: trusting the header without a real reverse proxy in front is spoofable. Required true in fail-closed tiers (see the superRefine below).
# HTTP_TRUST_PROXY=
# JSON bodies over this size are rejected 413.
# HTTP_BODY_LIMIT_BYTES=1048576
# Live-required. Comma-separated EXACT origins credentialed CORS reflects. No wildcard with credentials, ever — structurally unconstructible (http/security/cors.ts).
# HTTP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- observability ----------------------------------------------------------
# Live-required. OTLP-HTTP base endpoint; default targets the compose otel-lgtm.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service resource attribute: service name.
# OTEL_SERVICE_NAME=api
# Service resource attribute: service namespace.
# OTEL_SERVICE_NAMESPACE=reviews
# Live-required; e.g. dev, staging, prod.
# DEPLOYMENT_ENVIRONMENT=dev
# One of: fatal | error | warn | info | debug (no trace level).
# LOG_LEVEL=info

# --- persistence ------------------------------------------------------------
# Required. Runtime connection string; dev value targets the compose postgres (postgres://postgres:dev@localhost:5432/reviews).
DATABASE_URL=
# Live-required. Distinct owner connection for `moon run api:migrate` (ADR-0006); falls back to DATABASE_URL in non-live modes.
# DATABASE_OWNER_URL=
# Max pooled connections.
# DATABASE_POOL_SIZE=10

# --- messaging --------------------------------------------------------------
# Required. Dev value targets the compose redis (redis://localhost:6379).
REDIS_URL=

# --- auth -------------------------------------------------------------------
# Live-required. better-auth signing secret; a deployment supplies its own.
# AUTH_SECRET=dev-only-insecure-auth-secret-change-me-000000
# Live-required. Absolute origin magic links are minted against. Its scheme also decides the Secure cookie attribute: https ⇒ Secure, http ⇒ not.
# AUTH_BASE_URL=http://localhost:3000
# Comma-separated mountable methods. Values: magic-link | password | google-oauth | github-oauth. Empty ⇒ boot failure.
# AUTH_METHODS=magic-link
# Required as a PAIR with AUTH_GOOGLE_CLIENT_SECRET iff google-oauth is listed.
# AUTH_GOOGLE_CLIENT_ID=
# Required as a PAIR with AUTH_GOOGLE_CLIENT_ID iff google-oauth is listed.
# AUTH_GOOGLE_CLIENT_SECRET=
# Required as a PAIR with AUTH_GITHUB_CLIENT_SECRET iff github-oauth is listed.
# AUTH_GITHUB_CLIENT_ID=
# Required as a PAIR with AUTH_GITHUB_CLIENT_ID iff github-oauth is listed.
# AUTH_GITHUB_CLIENT_SECRET=
# ADR-0013. open | allowlist. Ships closed (allowlist) — open signup is one explicit config flip, visible in config review.
# AUTH_SIGNUP_POSTURE=allowlist
# Comma-separated exact addresses admitted to sign up under the allowlist posture. Required non-empty when AUTH_SIGNUP_POSTURE=allowlist in a fail-closed tier.
# AUTH_SIGNUP_ALLOWED_EMAILS=

# --- apps/app ---------------------------------------------------------------
# The SPA's entire config surface. Origin of this api as the BROWSER reaches it; the SPA
# appends the /api mount prefix itself. Read via import.meta.env — the documented
# exception to "no env outside @repo/config" — and inlined at build time, so changing it
# needs a rebuild, not a restart. Everything else the client needs arrives in the
# bootstrap payload.
# VITE_API_URL=http://localhost:3000
